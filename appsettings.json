{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FileCleanup": {
    "RunEveryMinutes": 1,
    "DeleteOlderThanMinutes": 2,
    "MaxFileSizeMB": 10,
    "MaxTotalStorageMB": 300,
    "TimezoneOffsetHours": 2
  }
}
